---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('posts', p => p.data.published);

const tagMap = new Map<string, number>();
posts.forEach(p => p.data.tags.forEach(t => tagMap.set(t, (tagMap.get(t) ?? 0) + 1)));
const tags = [...tagMap.entries()].sort(([a], [b]) => a.localeCompare(b));

const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Tags" description="Browse all tags on bobbok.">
  <h1 class="text-3xl font-bold text-ink dark:text-dark-text mb-8">Tags</h1>

  {tags.length === 0 ? (
    <p class="text-ink/50 dark:text-dark-text/50">No tags yet.</p>
  ) : (
    <ul class="flex flex-wrap gap-3 list-none p-0">
      {tags.map(([tag, count]) => (
        <li>
          <a
            href={`${base}tags/${tag}/`}
            class="inline-flex items-center gap-1.5 bg-lavender dark:bg-lavender/20 text-ink dark:text-dark-text rounded-full px-4 py-1.5 text-sm font-medium no-underline hover:opacity-80 transition-opacity"
          >
            #{tag}
            <span class="bg-ink/10 dark:bg-dark-text/10 rounded-full px-1.5 py-0.5 text-xs">{count}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
