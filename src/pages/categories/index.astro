---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('posts', p => p.data.published);

const catMap = new Map<string, number>();
posts.forEach(p => catMap.set(p.data.category, (catMap.get(p.data.category) ?? 0) + 1));
const categories = [...catMap.entries()].sort(([a], [b]) => a.localeCompare(b));

const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Categories" description="Browse all categories on bobbok.">
  <h1 class="text-3xl font-bold text-ink dark:text-dark-text mb-8">Categories</h1>

  {categories.length === 0 ? (
    <p class="text-ink/50 dark:text-dark-text/50">No categories yet.</p>
  ) : (
    <ul class="flex flex-wrap gap-3 list-none p-0">
      {categories.map(([cat, count]) => (
        <li>
          <a
            href={`${base}categories/${cat}`}
            class="inline-flex items-center gap-1.5 bg-mist dark:bg-mist/10 text-ink dark:text-dark-text rounded-full px-4 py-1.5 text-sm font-medium no-underline hover:opacity-80 transition-opacity"
          >
            {cat}
            <span class="bg-ink/10 dark:bg-dark-text/10 rounded-full px-1.5 py-0.5 text-xs">{count}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
