---
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
const formattedDate = post.data.date.toLocaleDateString('en-GB', {
  day: 'numeric', month: 'short', year: 'numeric',
});
---
<article class="rounded-xl border border-sage/40 dark:border-dark-border bg-cream-dk dark:bg-dark-surface p-6 transition-shadow hover:shadow-md">
  <a href={`${base}posts/${post.id}`} class="no-underline group">
    <span class="inline-block text-xs font-medium uppercase tracking-wide text-dustblue dark:text-dustblue/80 mb-2 bg-mist dark:bg-mist/10 px-2.5 py-0.5 rounded-full">
      {post.data.category}
    </span>
    <h2 class="text-xl font-semibold text-ink dark:text-dark-text group-hover:text-dustblue transition-colors mt-2 mb-2">
      {post.data.title}
    </h2>
  </a>
  <p class="text-ink/70 dark:text-dark-text/70 text-sm mb-4 line-clamp-2">{post.data.description}</p>
  <div class="flex items-center justify-between flex-wrap gap-3">
    <TagList tags={post.data.tags} size="sm" />
    <time datetime={post.data.date.toISOString()} class="text-xs text-ink/50 dark:text-dark-text/50 shrink-0">
      {formattedDate}
    </time>
  </div>
</article>
