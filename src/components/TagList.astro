---
interface Props {
  tags: string[];
  size?: 'sm' | 'md';
}
const { tags, size = 'md' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<ul class="flex flex-wrap gap-2 list-none p-0 m-0">
  {tags.map(tag => (
    <li>
      <a
        href={`${base}tags/${tag}`}
        class:list={[
          'inline-block rounded-full font-medium no-underline transition-opacity hover:opacity-80',
          'bg-lavender text-ink dark:bg-lavender/20 dark:text-dark-text',
          size === 'sm' ? 'px-2 py-0.5 text-xs' : 'px-3 py-1 text-sm',
        ]}
      >
        #{tag}
      </a>
    </li>
  ))}
</ul>
